
<h1><%= @animal.name %></h1>

<p><strong>Species:</strong> <%= @animal.species %></p>
<p><strong>Breed:</strong> <%= @animal.breed %></p>
<p><strong>Age:</strong> <%= @animal.age %></p>

<p>
  <strong>Intake Date:</strong>
  <%= @animal.intake_date&.strftime("%B %d, %Y") || "Not provided" %>
</p>

<p>
  <strong>Adoption Status:</strong>
  <%= @animal.adopted? ? "Adopted" : "Available for Adoption" %>
</p>

<h3>Additional Notes</h3>
<%= simple_format(@animal.notes.presence || "No notes available.") %>

<hr>

<p><%= link_to "Back to Animals", animals_path %></p>
<p><%= link_to "Edit Animal", edit_animal_path(@animal) %></p>

<%= button_to "Delete Animal", @animal,
    method: :delete,
    data: { turbo_confirm: "Are you sure you want to delete this animal?" } %>

    